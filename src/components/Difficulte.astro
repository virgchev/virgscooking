---
// Difficulté d'une recette : une cuillère en bois de plus en plus tachée (1 à 4).
// Niveau 4 = « Chef étoilé » : cuillère très sale, avec une étoile.
const { niveau = 1 } = Astro.props;
const n = Math.min(4, Math.max(1, Number(niveau) || 1));
const libelles = ['Facile', 'Moyen', 'Costaud', 'Chef étoilé'];
---
<span class="difficulte" title={`Difficulté : ${libelles[n - 1]}`}>
  <svg viewBox="-6 0 56 84" aria-hidden="true">
    <g transform="rotate(28 22 42)">
      <rect x="18.5" y="30" width="7" height="50" rx="3.5" fill="#C99A5B" stroke="#8A5A2B" stroke-width="1.2"/>
      <path d="M22 34v42" stroke="#A8743C" stroke-width=".7" opacity=".6"/>
      <ellipse cx="22" cy="18" rx="12" ry="16" fill="#C99A5B" stroke="#8A5A2B" stroke-width="1.2"/>
      <ellipse cx="22" cy="18" rx="8.5" ry="12" fill="#B07A41"/>
      {n === 2 && (
        <Fragment>
          <circle cx="18" cy="14" r="2.6" fill="#B3261E"/>
          <circle cx="25" cy="22" r="1.8" fill="#B3261E"/>
          <ellipse cx="22" cy="45" rx="2.4" ry="3.4" fill="#B3261E"/>
          <circle cx="21" cy="53" r="1" fill="#B3261E"/>
        </Fragment>
      )}
      {n >= 3 && (
        <Fragment>
          <ellipse cx="22" cy="19" rx="8.5" ry="12" fill="#8E1B16"/>
          <ellipse cx="19" cy="14" rx="3" ry="4" fill="#B3261E" opacity=".8"/>
          <path d="M18.5 30 C18 42 20 50 22 57 C24 50 26 42 25.5 30Z" fill="#8E1B16"/>
          <ellipse cx="23.5" cy="40" rx="1.6" ry="2.4" fill="#5A3A1A"/>
          <circle cx="21" cy="68" r="2.2" fill="#E0A82E"/>
          <circle cx="12" cy="6" r="1.8" fill="#8E1B16"/>
          <circle cx="34" cy="14" r="1.4" fill="#B3261E"/>
          <circle cx="32" cy="28" r="1.8" fill="#5D7B2F"/>
          <circle cx="10" cy="30" r="1.3" fill="#8E1B16"/>
        </Fragment>
      )}
      {n === 4 && (
        <Fragment>
          <ellipse cx="26" cy="12" rx="2" ry="3" fill="#3B2412" opacity=".85"/>
          <circle cx="14" cy="26" r="1.1" fill="#3B2412"/>
          <circle cx="29" cy="40" r="1.4" fill="#E0A82E"/>
          <circle cx="15" cy="48" r="1.5" fill="#5D7B2F"/>
          <circle cx="30" cy="2" r="1.1" fill="#3B2412"/>
        </Fragment>
      )}
    </g>
    {n === 4 && (
      <polygon points="8.0,2.0 10.0,7.2 15.6,7.5 11.2,11.1 12.7,16.5 8.0,13.4 3.3,16.5 4.8,11.1 0.4,7.5 6.0,7.2" fill="#F2B705" stroke="#B8860B" stroke-width="1" stroke-linejoin="round"/>
    )}
  </svg>
  <span>{libelles[n - 1]}</span>
</span>
