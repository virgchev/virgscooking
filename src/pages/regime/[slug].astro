---
import Base from "../../layouts/Base.astro";
import ListeRecettes from "../../components/ListeRecettes.astro";
import { cheminsIndex } from "../../utils/recettes";

export async function getStaticPaths() {
  return cheminsIndex("regimes");
}
const { nom, recettes } = Astro.props;
---
<Base titre={`${nom} – Virg's Cooking`}>
  <ListeRecettes
    nom={nom}
    recettes={recettes}
    note="Pensez à vérifier les étiquettes des produits que vous utilisez (traces, ingrédients transformés)."
  />
</Base>