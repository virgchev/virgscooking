---
// Difficulté d'une recette : de 1 à 4 cuillères 🥄 avec un mot.
const { niveau = 1 } = Astro.props;
const n = Math.min(4, Math.max(1, Number(niveau) || 1));

const libelles = [
  '',
  '',
  '',
  ''
];
---

<span class="difficulte" title={`Difficulté : ${libelles[n - 1]}`}>
  <span class="label">Difficulté :</span>
  <span class="emojis" aria-hidden="true">
    {'🥄'.repeat(n)}
  </span>
  <span class="niveau">{libelles[n - 1]}</span>
</span>
